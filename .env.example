# Copy to .env and fill in (never commit .env)
PORT=3000

# PayPal Sandbox — https://developer.paypal.com > Apps & Credentials > Sandbox
# Demo works WITHOUT these (mock checkout mode), but real PayPal needs them.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-secret
PAYPAL_MODE=sandbox

# AI — OpenAI compatible. Demo works WITHOUT a key (built-in stub provider).
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional: comma-separated test buyer note
DEMO_STORE_NAME=ShopGenie Demo Store
